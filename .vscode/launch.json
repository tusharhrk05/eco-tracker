{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Eco-Tracker (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Running on (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "env": {
        "PORT": "5001",
        "ECO_TRACKER_DEBUG": "1"
      }
    }
  ]
}
